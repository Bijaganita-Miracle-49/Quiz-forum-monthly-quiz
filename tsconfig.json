{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["db/**/*.ts", "server/**/*.ts", "netlify/functions/**/*.mts", "drizzle.config.ts", "config.js", "questions.js"]
}
